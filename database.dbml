Enum user_role {
  ADMIN
  STORE_MANAGER
  CASHIER
}

Enum payment_status {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

Enum payment_method {
  CASH
  MIDTRANS_QRIS
  MIDTRANS_VA
  MIDTRANS_CC
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'External REST API Reference']
  username varchar(50) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  role user_role [not null, default: 'CASHIER']
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table members {
  id uuid [pk, default: `gen_random_uuid()`]
  member_code varchar(20) [unique, not null, note: 'Public Display Identifier']
  
  name_encrypted bytea [not null, note: 'AES-256-GCM Encrypted']
  phone_encrypted bytea [not null, note: 'AES-256-GCM Encrypted']
  email_encrypted bytea [note: 'AES-256-GCM Encrypted']
  phone_bindex varchar(64) [not null, note: 'HMAC-SHA256 Exact Search']
  email_bindex varchar(64) [note: 'HMAC-SHA256 Exact Search']
  
  points int [not null, default: 0]
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  category_id uuid [not null]
  name varchar(150) [not null]
  sku varchar(50) [not null, note: 'Partial Unique Index (where deleted_at IS NULL)']
  price numeric(12,3) [not null]
  stock numeric(12,3) [not null, default: 0]
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table taxes {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(50) [unique, not null, note: 'e.g., PPN, PBJT, Service Charge']
  rate numeric(5,2) [not null, note: 'e.g., 11.00, 10.00']
  is_active boolean [not null, default: true]
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table product_taxes {
  product_id uuid [not null]
  tax_id uuid [not null]
  
  Indexes {
    (product_id, tax_id) [pk]
  }
}

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  order_no varchar(50) [unique, not null]
  
  user_id uuid [not null, note: 'Kasir yang melayani (Wajib)']
  member_id uuid [note: 'Pelanggan (Nullable jika tamu umum)']
  
  payment_method payment_method [not null, default: 'CASH']
  payment_status payment_status [not null, default: 'PENDING']
  
  total_qty numeric(12,3) [not null]
  sub_total numeric(12,3) [not null, note: 'Total harga dasar (Base Price * Qty)']
  total_tax numeric(12,3) [not null, note: 'Akumulasi dari semua pajak']
  grand_total numeric(12,3) [not null, note: 'Sub Total + Total Tax']
  
  created_at timestamptz [not null, default: `now()`]
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_id uuid [not null] 
  product_name varchar(150) [not null]
  base_price numeric(12,3) [not null]
  qty numeric(12,3) [not null]
  sub_total numeric(12,3) [not null, note: 'Base Price * Qty']
}

Table order_item_taxes {
  id uuid [pk, default: `gen_random_uuid()`]
  order_item_id uuid [not null]
  tax_id uuid [note: 'Nullable: Referensi ke Master Tax']
  
  tax_name varchar(50) [not null, note: 'Snapshot: "PPN", "PBJT"']
  tax_rate numeric(5,2) [not null, note: 'Snapshot: 11.00, 10.00']
  tax_amount numeric(12,3) [not null, note: '(OrderItem.sub_total * tax_rate) / 100']
}

Ref: products.category_id > categories.id [delete: restrict, update: cascade]
Ref: product_taxes.product_id > products.id [delete: cascade, update: cascade]
Ref: product_taxes.tax_id > taxes.id [delete: cascade, update: cascade]

Ref: orders.user_id > users.id [delete: restrict, update: cascade]
Ref: orders.member_id > members.id [delete: set null, update: cascade]

Ref: order_items.order_id > orders.id [delete: cascade, update: cascade]
Ref: order_items.product_id > products.id [delete: restrict, update: cascade]
Ref: order_item_taxes.order_item_id > order_items.id [delete: cascade, update: cascade]
Ref: order_item_taxes.tax_id > taxes.id [delete: set null, update: cascade]
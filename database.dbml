// ==========================================
// ENUMS
// ==========================================
Enum user_role {
  ADMIN
  STORE_MANAGER
  CASHIER
}

Enum payment_status {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

Enum payment_method {
  CASH
  MIDTRANS_QRIS
  MIDTRANS_VA
  MIDTRANS_CC
}

// ==========================================
// TABLES (Hybrid BIGINT Internal + UUID External + Audit Trail)
// ==========================================

Table users {
  id uuid [unique, not null, default: `gen_random_uuid()`, note: 'External REST API Reference']
  username varchar(50) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  role user_role [not null, default: 'CASHIER']
  deleted_at timestamptz [not null, default: `now()`]

  // Audit Metadata (ISO 27001 A.8.15)
  // created_by_id bigint [ref: > users.id, note: 'Nullable (self register/seeder)']
  // updated_by_id bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    id
  }

  Note: 'ISO 27001 A.5.15 - RBAC & Authentication'
}

Table members {
  id uuid [unique, not null, default: `gen_random_uuid()`]
  member_code varchar(20) [unique, not null, note: 'Public Display Identifier']

  // Encrypted PII Data (ISO 27001 A.8.24)
  name_encrypted bytea [not null, note: 'AES-256-GCM Encrypted']
  phone_encrypted bytea [not null, note: 'AES-256-GCM Encrypted']
  email_encrypted bytea [note: 'AES-256-GCM Encrypted']

  // Blind Index
  phone_bindex varchar(64) [not null, note: 'HMAC-SHA256 Exact Search']
  email_bindex varchar(64) [note: 'HMAC-SHA256 Exact Search']

  points int [not null, default: 0]
  deleted_at timestamptz [not null, default: `now()`]

  // Audit Metadata
  // created_by_id bigint [ref: > users.id]
  // updated_by_id bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    id
    phone_bindex
    email_bindex
  }

  Note: 'ISO 27001 A.8.24 - Encrypted PII & Blind Index'
}

Table categories {
  id uuid [unique, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null]

  // Audit Metadata
  // created_by_id bigint [ref: > users.id]
  // updated_by_id bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [not null, default: `now()`]

  Indexes {
    id
  }

}

Table products {
  id uuid [unique, not null, default: `gen_random_uuid()`]
  category_id bigint [ref: > categories.id]
  sku varchar(50) [unique, not null]
  name varchar(150) [not null]
  price numeric(15,2) [not null]
  stock int [not null, default: 0]

  // Audit Metadata
  // created_by_id bigint [ref: > users.id]
  // updated_by_id bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [not null, default: `now()`]

  Indexes {
    id
  }

}

Table orders {
  id uuid [unique, not null, default: `gen_random_uuid()`]
  invoice_number varchar(50) [unique, not null]
  cashier_id bigint [not null, ref: > users.id]
  member_id bigint [ref: > members.id]
  subtotal numeric(15,2) [not null]
  discount_amount numeric(15,2) [not null, default: 0]
  grand_total numeric(15,2) [not null]
  status payment_status [not null, default: 'PENDING']
  payment_method payment_method

  // Audit Metadata
  // created_by_id bigint [ref: > users.id]
  // updated_by_id bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    id
  }

}

Table order_items {
  order_id bigint [not null, ref: > orders.id]
  product_id bigint [not null, ref: > products.id]
  product_name varchar(150) [not null]
  price numeric(15,2) [not null]
  quantity int [not null]
  subtotal numeric(15,2) [not null]

  Indexes {
    order_id
  }

}

Table midtrans_transactions {
  id uuid [unique, not null, default: `gen_random_uuid()`]
  order_id bigint [not null, ref: > orders.id]
  idempotency_key varchar(100) [unique, not null]
  snap_token varchar(255)
  midtrans_transaction_id varchar(100)
  payment_type varchar(50)
  gross_amount numeric(15,2) [not null]
  transaction_status varchar(50) [not null]
  signature_key_hash varchar(128) [not null]
  raw_payload jsonb [not null]

  // Audit Metadata
  // created_by_id bigint [ref: > users.id]
  // updated_by_id bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    id
  }

  Note: 'ISO 27001 A.8.14 - Webhook Integrity & Idempotency'
}

Table audit_logs {
  actor_id bigint [ref: > users.id]
  actor_role varchar(20) [not null]
  action varchar(100) [not null]
  entity_name varchar(50) [not null]
  entity_id uuid
  old_values jsonb
  new_values jsonb
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  Note: 'ISO 27001 A.8.15 - Append-Only Immutable Audit Trail'
}